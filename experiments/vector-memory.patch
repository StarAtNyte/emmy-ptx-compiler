+    @staticmethod
+    def residues(expr, modulus):
+        """Conservative possible index residues; unknown values permit all."""
+        unknown = set(range(modulus))
+        if isinstance(expr, Literal):
+            return {int(expr.value) % modulus}
+        if isinstance(expr, BinaryExpr):
+            left = Compiler.residues(expr.left, modulus)
+            right = Compiler.residues(expr.right, modulus)
+            functions = {'+': lambda a,b: a+b, '-': lambda a,b: a-b,
+                         '*': lambda a,b: a*b}
+            if expr.op in functions:
+                return {functions[expr.op](a,b) % modulus for a in left for b in right}
+            if (expr.op == '%' and isinstance(expr.right, Literal)
+                    and int(expr.right.value) != 0 and int(expr.right.value) % modulus == 0):
+                return left
+        return unknown
+
+    def vector_aligned(self, buffer, index, width):
+        # Device buffer allocations have at least 16-byte base alignment. Shared
+        # declarations may promise only four bytes, so keep their accesses scalar.
+        if width not in (2,4) or buffer in self.shared:
+            return False
+        residues = {0}
+        for coordinate, extent in zip(index, self.shapes[buffer]):
+            coordinate_residues = self.residues(coordinate, width)
+            residues = {(a * extent + b) % width for a in residues for b in coordinate_residues}
+        return residues == {0}
+
